{
  "name": "gestionmomo-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "build:android:debug": "cd android && gradlew assembleDebug",
    "build:android:release": "cd android && gradlew assembleRelease",
    "build:apk": "cd android && gradlew assembleDebug && echo APK généré dans android/app/build/outputs/apk/debug/",
    "clean:android": "cd android && gradlew clean",
    "install:apk": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "deploy:android": "npm run build:apk && npm run install:apk"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "i18next": "^26.3.6",
    "react": "18.2.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.74.2",
    "react-native-localize": "^3.7.0",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "^3.32.0",
    "react-native-svg": "^15.8.0",
    "react-native-vector-icons": "^10.1.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/eslint-config": "^0.74.85",
    "eslint": "^8.19.0"
  }
}
